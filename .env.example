# Copy this to .env and fill in your values (do NOT commit .env)
NPS_API_KEY=YOUR_NPS_KEY_HERE
USER_AGENT=Your Name <email>

# Google Sheets (existing sheet recommended)
GOOGLE_SHEETS_UPLOAD=true
GOOGLE_SHEETS_SPREADSHEET_ID=YOUR_SHEET_ID
GOOGLE_SHEETS_WORKSHEET_NAME=Itinerary
GOOGLE_SHEETS_TITLE=NPS Itinerary
